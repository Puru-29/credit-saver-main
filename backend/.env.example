PORT=3000
MONGODB_URI=
# Optional DNS server IPs for MongoDB SRV lookups, comma-separated.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:8080
NODE_ENV=development
# Optional base URL for the future FastAPI ML service; ML features remain unavailable when unset.
ML_SERVICE_URL=http://localhost:8001
# Optional RTI draft template; use {{description}}, {{authorityBlock}}, and {{receivingOfficeBlock}}.
# Escape newlines as \n when setting a multi-line template.
# RTI_APPLICATION_TEMPLATE=
# Optional comma-separated subset of TENANT,GIG_WORKER_WORKPLACE.
# RIGHTS_CATEGORIES=TENANT,GIG_WORKER_WORKPLACE
# Optional custom referral text shown only when the user marks a matter urgent.
# RIGHTS_LEGAL_AID_MESSAGE=
